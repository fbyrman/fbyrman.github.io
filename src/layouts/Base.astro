---
interface Props { title?: string; description?: string }
const { title, description = 'Freek Byrman: research and projects in machine learning.' } = Astro.props;
const fullTitle = title ? `${title} · Freek Byrman` : 'Freek Byrman';
const path = Astro.url.pathname;
const nav = [
  { href: '/research/', label: 'Research' },
  { href: '/projects/', label: 'Projects' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600&display=swap" />
  </head>
  <body>
    <header>
      <a class="name" href="/">Freek Byrman</a>
      <nav>
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <a href="mailto:freek.byrman@gmail.com">Email</a>
      <a href="https://github.com/fbyrman">GitHub</a>
      <a href="https://scholar.google.nl/citations?user=lFo-JiYAAAAJ">Google Scholar</a>
    </footer>
  </body>
</html>

<style is:global>
  /* Same palette and type as the explainers (the Gromov loss notes). */
  :root {
    --bg: #F3F1EB;
    --fg: #1B1D22;
    --muted: #55575F;
    --rule: #D8D3C6;
    --accent: #2E4373;
    --gold: #B8863A;
    --tag-bg: #EAE6DC;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15161A;
      --fg: #EDECE7;
      --muted: #A7A9B2;
      --rule: #33353D;
      --accent: #8FA3D6;
      --gold: #E0B15E;
      --tag-bg: #1D1F25;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0 auto;
    max-width: 44rem;
    padding: 2.5rem 1rem 3rem;
    background: var(--bg);
    color: var(--fg);
    font: 17px/1.65 'Source Serif 4', Georgia, serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 2px; }
  header { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; align-items: baseline; justify-content: space-between; margin-bottom: 2.5rem; }
  header .name { font-weight: 700; font-size: 1.2rem; color: var(--fg); text-decoration: none; }
  nav { display: flex; gap: 1.25rem; font-family: Inter, system-ui, sans-serif; font-size: 0.9rem; }
  nav a { color: var(--muted); text-decoration: none; }
  nav a[aria-current='page'], nav a:hover { color: var(--fg); }
  h1 { font-size: 1.9rem; font-weight: 600; line-height: 1.2; margin: 0 0 0.5rem; }
  h2 { font-size: 1.25rem; font-weight: 600; margin: 2.25rem 0 0.75rem; }
  main > h2:first-child { margin-top: 0; }
  h2 a { color: var(--fg); text-decoration: none; }
  h2 a:hover { color: var(--accent); }
  .muted { color: var(--muted); }
  .meta { color: var(--muted); font-family: Inter, system-ui, sans-serif; font-size: 0.8rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin: 0.4rem 0 0; padding: 0; list-style: none; }
  .tags li { background: var(--tag-bg); border-radius: 4px; padding: 0.05rem 0.45rem; font-family: Inter, system-ui, sans-serif; font-size: 0.75rem; }
  .links { display: flex; flex-wrap: wrap; gap: 1rem; font-family: Inter, system-ui, sans-serif; font-size: 0.85rem; }
  img { max-width: 100%; height: auto; border-radius: 4px; }
  footer { margin-top: 4rem; padding-top: 1rem; border-top: 1px solid var(--rule); display: flex; gap: 1.25rem; font-family: Inter, system-ui, sans-serif; font-size: 0.85rem; }
</style>
